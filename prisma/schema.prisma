datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Configuración General (Hero, Header, Footer, Hero Badge)
model SiteConfig {
  id               String   @id @default("global")
  heroTitle        String   @default("Hacia una distribución justa 50/50")
  heroSubtitle     String   @default("Transformando la descentralización tributaria en Bolivia.")
  heroCtaText      String   @default("Explorar Agenda")
  heroCtaLink      String   @default("#pilares")
  badgeText        String   @default("Acuerdo N° 001/2026 de Sucre")
  acuerdoDateText  String   @default("5 de Agosto de 2026")
  feedbackEmail    String?  @default("propuestas@agenda5050.gob.bo")
  feedbackTitle    String?  @default("Buzón de Propuestas y Aportes")
  feedbackSubtitle String?  @default("Envía tus sugerencias o propuestas institucionales para ser evaluadas por las Mesas Técnicas.")
  smtpHost         String?
  smtpPort         Int?     @default(587)
  smtpUser         String?
  smtpPass         String?
  smtpSecure       Boolean? @default(false)
  smtpFrom         String?
  updatedAt        DateTime @updatedAt
}

// 2. Pilares de Autonomía (Pillars)
model Pillar {
  id          Int      @id @default(autoincrement())
  order       Int      @default(0)
  title       String
  category    String   // "Fiscal" | "Competencial" | "Institucional" | "Normativo"
  iconName    String
  summary     String
  actions     String   // Almacenado como JSON array string: ["accion 1", "accion 2"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. Hitos de la Agenda (Timeline)
model Milestone {
  id           Int      @id @default(autoincrement())
  order        Int      @default(0)
  title        String
  dateText     String
  status       String   // "Cumplido" | "En proceso" | "Programado" | "Meta"
  detail       String
  documents    String?  // JSON string: [{"name": "Doc.pdf", "size": "3.2MB"}]
  participants String?  // JSON string: ["MEFP", "9 GAD"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 4. Datos por Departamento (Monitor)
model DepartmentData {
  id                 String   @id // "LP", "SC", "CB", etc.
  name               String
  capital            String
  governor           String
  adhered            Boolean  @default(true)
  adhesionDate       String
  currentFiscalRatio String
  target5050Impact   String
  keyProjects        String   // JSON string: ["Proyecto 1", "Proyecto 2"]
  mesasCount         Int      @default(0)
  regionalNotes      String
  pathD              String
  updatedAt          DateTime @updatedAt
}

// 5. Repositorio Documental (DocumentHub)
model DocumentItem {
  id             String   @id @default(cuid())
  title          String
  category       String   // "Acuerdo" | "Proyecto de Ley" | "Decreto" | "Presentación" | "Acta"
  department     String?
  date           String
  fileUrl        String?  // Ruta en /uploads/... o URL
  fileSize       String
  description    String
  downloadsCount Int      @default(0)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 6. Hub Multimedia (MultimediaHub - Audios/Podcasts/Videos/Webinars/Reuniones/Medios)
model MediaItem {
  id          String   @id @default(cuid())
  title       String
  type        String   // "audios" | "videos" | "medios" | "reuniones" | "webinars"
  category    String?
  mediaUrl    String?  // Archivo mp3/mp4 subido o url externa
  embedUrl    String?  // URL de YouTube/Spotify/Soundcloud para iframe
  url         String?  // Link a fuente original
  platform    String?  // "Spotify" | "YouTube" | "SoundCloud" | "TikTok" | "Prensa"
  coverUrl    String?  // Thumbnail o imagen de portada
  duration    String?  // Ej. "45 min" o "03:15"
  date        String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 7. Administradores del Sistema / Seguridad CMS
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String    @default("Administrador Agenda 50/50")
  passwordHash     String
  role             String    @default("admin")
  resetToken       String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// 8. Preguntas Frecuentes (FAQ)
model FAQItem {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  category  String   // "General" | "Pacto Fiscal" | "Normativa" | "Transparencia"
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 9. Conceptos / Acordeón 50/50 (Monitor)
model ConceptStep {
  id        Int      @id @default(autoincrement())
  num       Int      @unique
  title     String
  desc      String
  tag       String
  items     String   // JSON string: ["Recursos", "Competencias", "Decisión"]
  updatedAt DateTime @updatedAt
}

// 10. Propuestas Ciudadanas (Co-construcción Ciudadana)
model CitizenProposal {
  id           String   @id @default(cuid())
  name         String
  email        String
  department   String
  organization String?
  proposal     String
  status       String   @default("Pendiente") // "Pendiente" | "Revisado" | "Derivado" | "Archivado"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


