datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Configuración General (Hero, Header, Footer, Hero Badge)
model SiteConfig {
  id               String   @id @default("global")
  heroTitle        String   @default("Hacia una distribución justa 50/50")
  heroSubtitle     String   @default("Transformando la descentralización tributaria en Bolivia.")
  heroCtaText      String   @default("Explorar Agenda")
  heroCtaLink      String   @default("#pilares")
  badgeText        String   @default("Acuerdo N° 001/2026 de Sucre")
  acuerdoDateText  String   @default("5 de Agosto de 2026")
  feedbackEmail    String?  @default("propuestas@agenda5050.gob.bo")
  feedbackTitle    String?  @default("Buzón de Propuestas y Aportes")
  feedbackSubtitle String?  @default("Envía tus sugerencias o propuestas institucionales para ser evaluadas por las Mesas Técnicas.")
  smtpHost         String?
  smtpPort         Int?     @default(587)
  smtpUser         String?
  smtpPass         String?
  smtpSecure       Boolean? @default(false)
  smtpFrom         String?
  updatedAt        DateTime @updatedAt
}

// 2. Pilares de Autonomía (Pillars)
model Pillar {
  id          Int      @id @default(autoincrement())
  order       Int      @default(0)
  title       String
  category    String   // "Fiscal" | "Competencial" | "Institucional" | "Normativo"
  iconName    String
  summary     String
  actions     String   // Almacenado como JSON array string: ["accion 1", "accion 2"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 18. Control de Visibilidad Global de Productos y Submódulos
model SiteModuleConfig {
  key          String   @id // "revista" | "ruta-viva" | "ruta-viva-mapa" | "ruta-viva-timeline" | "ruta-viva-kit" | "semaforizacion-ejecutiva"
  label        String
  enabled      Boolean  @default(true)
  showInNavbar Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// 19. Revista Digital 50/50 — Ediciones
model RevistaEdition {
  id            String           @id @default(cuid())
  slug          String           @unique
  editionNumber Int
  title         String
  subtitle      String
  periodLabel   String
  coverImage    String?
  isVisible     Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  publishedAt   String?
  order         Int              @default(0)
  chapters      RevistaChapter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// 20. Revista Digital 50/50 — Capítulos por Edición
model RevistaChapter {
  id               String         @id @default(cuid())
  editionId        String
  edition          RevistaEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  slug             String
  order            Int            @default(0)
  kicker           String
  title            String
  summary          String
  content          String
  quoteText        String?
  quoteSource      String?
  linkedActor      String?
  linkedDocumentId String?
  linkedMediaId    String?
  isVisible        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([editionId, slug])
  @@index([editionId])
}

// 21. Ruta Viva 50/50 — Sedes Territoriales
model RutaVivaSede {
  id                String   @id @default(cuid())
  slug              String   @unique
  city              String
  department        String
  lat               Float
  lng               Float
  title             String
  dateLabel         String
  actors            String
  summary           String
  keyFiguresJson    String   // JSON array string
  linkedDocumentId  String?
  linkedChapterSlug String?
  accent            String   @default("emerald") // "emerald" | "gold" | "red"
  order             Int      @default(0)
  isVisible         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 22. Ruta Viva 50/50 — Tarjetas del Kit de Redes y Prensa
model RutaVivaCard {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  subtitle      String
  heroStat      String
  heroStatLabel String
  bulletsJson   String   // JSON array string
  footerNote    String
  copyText      String
  templateType  String   @default("emerald") // "emerald" | "gold" | "red"
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 3. Hitos de la Agenda (Timeline)
model Milestone {
  id           Int      @id @default(autoincrement())
  order        Int      @default(0)
  title        String
  dateText     String
  status       String   // "Cumplido" | "En proceso" | "Programado" | "Meta"
  detail       String
  image        String?
  documents    String?  // JSON string: [{"name": "Doc.pdf", "size": "3.2MB"}]
  participants String?  // JSON string: ["MEFP", "9 GAD"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 4. Datos por Departamento (Monitor)
model DepartmentData {
  id                 String   @id // "LP", "SC", "CB", etc.
  name               String
  capital            String
  governor           String
  adhered            Boolean  @default(true)
  adhesionDate       String
  currentFiscalRatio String
  target5050Impact   String
  keyProjects        String   // JSON string: ["Proyecto 1", "Proyecto 2"]
  mesasCount         Int      @default(0)
  regionalNotes      String
  pathD              String
  updatedAt          DateTime @updatedAt
}

// 5. Repositorio Documental (DocumentHub)
model DocumentItem {
  id             String              @id @default(cuid())
  title          String
  category       String              // "Acuerdo" | "Proyecto de Ley" | "Decreto" | "Presentación" | "Acta"
  department     String?
  date           String
  fileUrl        String?             // Ruta en /uploads/... o URL
  fileSize       String
  description    String
  downloadsCount Int                 @default(0)
  featured       Boolean             @default(false)
  fileHash       String?
  indexStatus    String              @default("PENDING") // "PENDING" | "INDEXING" | "INDEXED" | "ERROR"
  pageCount      Int                 @default(0)
  indexError     String?
  lastIndexedAt  DateTime?
  pages          DocumentPageIndex[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// 5b. Índice de Texto / OCR por Página de PDF
model DocumentPageIndex {
  id                String       @id @default(cuid())
  documentId        String
  document          DocumentItem @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber        Int
  contentRaw        String
  contentNormalized String
  indexedAt         DateTime     @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

// 6. Hub Multimedia (MultimediaHub - Audios/Podcasts/Videos/Webinars/Reuniones/Medios)
model MediaItem {
  id          String   @id @default(cuid())
  title       String
  type        String   // "audios" | "videos" | "medios" | "reuniones" | "webinars"
  category    String?
  mediaUrl    String?  // Archivo mp3/mp4 subido o url externa
  embedUrl    String?  // URL de YouTube/Spotify/Soundcloud para iframe
  url         String?  // Link a fuente original
  platform    String?  // "Spotify" | "YouTube" | "SoundCloud" | "TikTok" | "Prensa"
  coverUrl    String?  // Thumbnail o imagen de portada
  duration    String?  // Ej. "45 min" o "03:15"
  date        String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



// 18. Control de Visibilidad Global de Productos y Submódulos
