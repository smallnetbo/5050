  id          Int      @id @default(autoincrement())
  nivel       String   // "2.1" | "2.2" | "2.3" | "2.4" | "2.6" | "2.7"
  rubro       String   // "fiscal" | "energia" | "salud" | "seguridad" | "ley" | "institucional" | "acuerdos" | "datos"
  tematica    String
  entregable  String
  responsable String
  estado      String   // "Cumplido", "En proceso", "Noviembre 2026", "Continuo", "Sin plazo", etc.
  cat         String   // "cumplido" | "proceso" | "programado" | "sin_plazo"
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 18. Control de Visibilidad Global de Productos y Submódulos
model SiteModuleConfig {
  key          String   @id // "revista" | "ruta-viva" | "ruta-viva-mapa" | "ruta-viva-timeline" | "ruta-viva-kit" | "semaforizacion-ejecutiva"
  label        String
  enabled      Boolean  @default(true)
  showInNavbar Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// 19. Revista Digital 50/50 — Ediciones
model RevistaEdition {
  id            String           @id @default(cuid())
  slug          String           @unique
  editionNumber Int
  title         String
  subtitle      String
  periodLabel   String
  coverImage    String?
  isVisible     Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  publishedAt   String?
  order         Int              @default(0)
  chapters      RevistaChapter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// 20. Revista Digital 50/50 — Capítulos por Edición
model RevistaChapter {
  id               String         @id @default(cuid())
  editionId        String
  edition          RevistaEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  slug             String
  order            Int            @default(0)
  kicker           String
  title            String
  summary          String
  content          String
  quoteText        String?
  quoteSource      String?
  linkedActor      String?
  linkedDocumentId String?
  linkedMediaId    String?
  isVisible        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([editionId, slug])
  @@index([editionId])
}

// 21. Ruta Viva 50/50 — Sedes Territoriales
model RutaVivaSede {
  id                String   @id @default(cuid())
  slug              String   @unique
  city              String
  department        String
  lat               Float
  lng               Float
  title             String
  dateLabel         String
  actors            String
  summary           String
  keyFiguresJson    String   // JSON array string
  linkedDocumentId  String?
  linkedChapterSlug String?
  accent            String   @default("emerald") // "emerald" | "gold" | "red"
  order             Int      @default(0)
  isVisible         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 22. Ruta Viva 50/50 — Tarjetas del Kit de Redes y Prensa
model RutaVivaCard {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  subtitle      String
  heroStat      String
  heroStatLabel String
  bulletsJson   String   // JSON array string
  footerNote    String
  copyText      String
  templateType  String   @default("emerald") // "emerald" | "gold" | "red"
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

